# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/chapel_of_faith
SECRET_KEY=change-me-to-a-long-random-string

# A separate, empty database used only by pytest. The tests wipe it on every run.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/chapel_test
