# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/chapel_of_faith

# Signs the admin login tokens. Must be at least 32 random characters: the server
# refuses to start with a short key or with this example value. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Websites allowed to call the API from the browser (comma separated). Optional:
# the default is the Vite dev server, http://localhost:5173. "*" is not allowed.
# CORS_ORIGINS=http://localhost:5173

# Where uploaded images are saved. Optional: the default is backend/media.
# A relative path is taken from the backend/ folder.
# MEDIA_DIR=media

# The church's time zone, used for "today's devotion" and "upcoming events". Optional.
# CHURCH_TIMEZONE=Africa/Lagos

# A separate, empty database used only by pytest. The tests wipe it on every run.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/chapel_test
